ANTHROPIC_API_KEY=your_anthropic_key_here

# Instagram / Meta webhook
INSTAGRAM_VERIFY_TOKEN=make_up_a_random_string_you_choose
META_PAGE_ACCESS_TOKEN=from_meta_app_dashboard
META_APP_SECRET=from_meta_app_dashboard
