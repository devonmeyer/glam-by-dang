# Connecting businesses through Instagram login (see businesses/README.md)
INSTAGRAM_APP_ID=instagram_app_id_from_meta_dashboard
PUBLIC_BASE_URL=https://itsmia.info
ADMIN_SECRET=make_up_a_long_random_string
TOKEN_ENCRYPTION_KEY=generate_with_python_-c_"from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
