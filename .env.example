ANTHROPIC_API_KEY=your_anthropic_key_here

# Instagram / Meta webhook
INSTAGRAM_VERIFY_TOKEN=make_up_a_random_string_you_choose
META_PAGE_ACCESS_TOKEN=from_meta_app_dashboard
META_APP_SECRET=from_meta_app_dashboard
DAILY_SUMMARY_RECIPIENT=instagram_psid_to_receive_daily_summary

# Required on Railway to use the web simulator and summary endpoints (sent as X-Simulator-Key).
# Leave unset locally to keep the simulator open on your machine.
SIMULATOR_SECRET=make_up_a_long_random_string
